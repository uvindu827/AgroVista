# Example environment variables for local development.
# Copy this file to Backend/.env and fill in real values.
#
# IMPORTANT: The previous insecure developer fallback `DEV_AUTH` has been removed
# from the codebase to avoid accidental authentication using environment
# variables in non-development environments. Do NOT expect `DEV_AUTH` to work.
# To test authentication locally, either run a local MongoDB instance and create
# a test user, or run the backend against a test/staging database.

# Server
PORT=3001

# MongoDB (example placeholder — use your own connection string)
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT secret for signing tokens (use a secure random string)
JWT_SECRET=your-jwt-secret-here

# ML service endpoint the backend should call
ML_URL=http://127.0.0.1:5001/predict

# Optional API key used by backend to authenticate to ML service
# If set here, the backend will forward it as X-API-KEY when calling ML_URL
ML_API_KEY=your-ml-api-key-here

# Optional: absolute path to a local PyTorch model file (used by ML scaffold)
MODEL_PATH=C:\path\to\your\model.pt

# Frontend/client URL (used in CORS and webhook redirects)
CLIENT_URL=http://localhost:3000

# If you need a quick dev-only convenience for running both services, use the
# PowerShell helper at `scripts/dev-all.ps1` or the root `npm run dev:all` script.
# Example (PowerShell):
#    .\scripts\dev-all.ps1 -Port 3001 -ModelPath 'C:\path\to\model.pt' -MLApiKey 'your-dev-key'
